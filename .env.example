# Two files, never committed (ADR 0013, docs/shared-setup.md). Exported shell variables win over both.

# --- <repo>/.env: personal, one per person and Mac (copy these lines to .env) ---
# CF_PERSON=madvil2                               # owner of Briefs, Video links and video Notes (default: the macOS user name)
# CF_LOCAL_ROOT=~/Movies/content-factory          # Footage, videos/, channels/, _models/ (default)
# CF_SHARED_ROOT=/Users/Shared/content-factory    # factory.db, references/, library/, packs/, secrets.env, backups/ (default)
# CF_FACTORY_DB=                                  # another store file (tests, smoke runs)
# CF_SECRETS_FILE=                                # another secrets file (tests point it at a missing one)

# --- <shared root>/secrets.env: one file for both people, mode 600, on the share ---
# The research CLI reads it when a key is asked for; `python -m cf.research ig token-refresh`
# rewrites the token line there. Values are secrets: never commit, print or paste them.

# YouTube Data API v3 key (scout, snapshot, add-channel for YouTube channels)
YOUTUBE_API_KEY=

# Instagram Graph API (ADR 0010): a long-lived Facebook user token of the Meta app
# (instagram_basic, instagram_manage_insights), the app that issued it, and the Author's
# Instagram business account id. `python -m cf.research ig token-status` shows the expiry.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
