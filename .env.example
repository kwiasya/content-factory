# Copy to .env (gitignored). The research CLI reads it when the variables are not exported.
# Values are secrets: never commit, print or paste them.

# YouTube Data API v3 key (scout, snapshot, add-channel for YouTube channels)
YOUTUBE_API_KEY=

# Instagram Graph API (ADR 0010): a long-lived Facebook user token of the Meta app
# (instagram_basic, instagram_manage_insights), the app that issued it, and the Author's
# Instagram business account id. `python -m cf.research ig token-status` shows the expiry,
# `ig token-refresh` renews the token in place.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
